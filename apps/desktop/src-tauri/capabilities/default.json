{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "DailyFlow desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "autostart:allow-disable",
    "autostart:allow-enable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
